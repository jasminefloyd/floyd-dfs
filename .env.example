# Copy this file to .env.local for local development.
# Do not commit real credentials.

# Supabase — values are intentionally unset until database setup is approved.
# These names match the current local environment configuration.
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# AI/model providers — values are intentionally unset in this template.
OPENAI_API_KEY=
CLAUDE_API_KEY=
AI_MODEL=

# Research providers.
WEATHER_API_KEY=
SPORTS_DATA_API_KEY=
SPORTS_DATA_IO_KEY=
SPORTS_DATA_IO_BASE_URL=https://api.sportsdata.io/v3

# DraftKings API — sport codes are discovered from the DraftKings sports directory.
DRAFTKINGS_API_BASE_URL=https://api.draftkings.com
DRAFTKINGS_LOBBY_BASE_URL=https://www.draftkings.com

# Runtime configuration.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
