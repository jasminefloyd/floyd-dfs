# Browser requests are same-origin in production. Leave this unset in Vercel.
VITE_FLOYD_DFS_API_URL=
# `npm run dev` uses Vite only; run `npm run dev:full` for local API handlers.
VITE_FLOYD_DFS_DEV_URL=http://127.0.0.1:3000

# Public browser-side Supabase configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Vercel function configuration. Never prefix these with VITE_ or expose them to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SPORTS_DATA_IO_KEY=
SPORTS_DATA_IO_BASE_URL=https://api.sportsdata.io/v3
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
THE_ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com
FIELD_SENTIMENT_URL=
ESPN_BASE_URL=https://site.api.espn.com/apis/site/v2
# Exact HTTPS hostnames approved for displaying provider player photos (comma-separated).
# Keep empty until provider rights and attribution are reviewed for the deployment.
FDS_PLAYER_PHOTO_ALLOWED_HOSTS=
# Revalidation interval for tenant-scoped photo metadata cache (defaults to 7 days).
FDS_PLAYER_PHOTO_CACHE_TTL_DAYS=7
# SerpAPI research capacity is bounded and all skipped game/player coverage is recorded in diagnostics.
FDS_RESEARCH_QUERY_BUDGET=8
FDS_RESEARCH_BATCH_SIZE=5
FDS_AVAILABILITY_FRESHNESS_MINUTES=5
FDS_CONTEXT_FRESHNESS_MINUTES=1440
# Swap recommendations expire this long after fresh projection generation (also bounded by the next game lock).
FDS_SWAP_PLAN_FRESHNESS_MINUTES=5
# Hard cap on deterministic optimizer search work per request; results are explicitly marked bounded if hit.
FDS_OPTIMIZER_MAX_SEARCH_NODES=50000
# Field diagnostics use a deterministic per-slate seed; increase only after worker-cost review (16-128).
FDS_FIELD_SIMULATIONS=64
# Hard cap on candidate × sample × opponent score comparisons (100000-5000000); excess candidates get no metrics.
FDS_FIELD_SIMULATION_MAX_COMPARISONS=2000000
# Context-only experimental effects remain numerically disabled until P11 validation.
FDS_ENABLE_EXPERIMENTAL_CONTEXT_EFFECTS=false
BALLDONTLIE_BASE_URL=https://api.balldontlie.io/v1
BALLDONTLIE_KEY=
SERPAPI_API_KEY=
FIRECRAWL_API_KEY=
RESEND_API_KEY=
WEEKLY_LEARNING_REPORT_EMAIL=
WEEKLY_LEARNING_REPORT_FROM=

# One application tenant per deployment; all end-user and service access is pinned to this tenant.
FDS_TENANT_SLUG=floyd-dfs

# Explicit authorization identities. Configure unique random secrets in deployment env.
FDS_OPERATOR_USER_IDS=
FDS_WORKER_BEARER_SECRET=
FDS_SCHEDULER_BEARER_SECRET=
# Set the same value in Vercel as CRON_SECRET so scheduled requests include this bearer token.
CRON_SECRET=

# P02 production migration safeguards. Set the expected ref only after owner review.
FDS_EXPECTED_SUPABASE_PROJECT_REF=
FDS_P02_BACKUP_DIR=
FDS_P02_WRITERS_PAUSED=false
